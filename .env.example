# ─────────────────────────────────────────────────────────────────────────────
# CivicPulse configuration. EVERYTHING IS OPTIONAL: with an empty .env.local the
# platform runs fully offline (embedded PGlite database, rule-based AI, SSE).
# Every service below has a FREE tier; no paid service is ever required.
# Copy to .env.local and fill what you want to enable.
# ─────────────────────────────────────────────────────────────────────────────

NEXT_PUBLIC_APP_NAME=CivicPulse

# Security (change for any public deployment)
SECRET_KEY=change-me-to-a-long-random-string            # JWT signing + federation HMAC
PSEUDONYM_HMAC_SECRET=change-me                          # reporter pseudonyms (HMAC-SHA256)
CONTACT_ENCRYPTION_KEY=change-me                         # AES-256-GCM for reply channels
INTAKE_API_KEY=change-me                                 # X-Intake-Key for the IVR webhook

# Database: leave empty to use embedded PGlite (stored in .data/pglite).
# Free: Supabase → Project Settings → Database → Connection string (URI, "Transaction pooler").
DATABASE_URL=
PGLITE_DIR=.data/pglite
DATA_DIR=.data                                           # audio storage; use /tmp on Vercel
AUTO_SEED=true                                           # build the synthetic BRICS demo world on first boot

# Free multi-modal AI + fast inference (Google AI Studio: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional open-source fallback LLM + speech-to-text (Groq: https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b                           # text model
GROQ_STT_MODEL=whisper-large-v3
GROQ_VISION_MODEL=qwen/qwen3.8-27b                       # analyses citizen evidence photos
PHOTO_AI=on                                              # off = never send photos to a vision model

# Translation fallback when no LLM key is set: MyMemory public API (free, no key) or none
TRANSLATE_FALLBACK=mymemory

# Geocoding: local gazetteer first, then OpenStreetMap Nominatim (free, 1 req/s, cached)
GEOCODER=gazetteer_then_nominatim                        # or: offline
NOMINATIM_USER_AGENT=civicpulse-hackathon-demo (you@example.org)

# Telegram bot (free: talk to @BotFather). Polling mode needs no public URL.
TELEGRAM_BOT_TOKEN=
TELEGRAM_MODE=polling                                    # or: webhook → POST /api/v1/webhooks/telegram/<secret>
TELEGRAM_WEBHOOK_SECRET=change-me
APP_URL=                                                 # public https URL of a deployment; with TELEGRAM_MODE=webhook the bot registers there on boot

# Realtime across serverless instances (free Supabase project). Leave empty for local SSE.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Evidence photos: Cloudinary free tier (optional). Without it photos are stored in DATA_DIR/photos.
# NEVER hard-code these in source; rotate any key that was ever committed.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Government money-allocation feed (optional). Without it a synthetic PFMS-like ledger is used.
# ALLOCATION_API_URL returns [{scheme, project_ref, project_title?, category?, fy, sanctioned, released, utilised}] in INR.
ALLOCATION_API_URL=
# Or the Open Government Data platform (free key: https://data.gov.in) with a resource id carrying the same fields.
DATA_GOV_IN_API_KEY=
DATA_GOV_IN_RESOURCE=

# Firebase (free Spark plan, optional): citizen 'Continue with Google' + web push notifications.
# Console → Project settings → General → Your apps → Web app config (public values):
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Project settings → Cloud Messaging → Web Push certificates → Key pair:
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
# SECRET. Project settings → Service accounts → Generate new private key; paste the whole JSON on one line.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Also enable Authentication → Sign-in method → Google.

# Map tiles (free, no key)
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/dark

# Analytics & privacy knobs
CLUSTER_SIM_THRESHOLD=0.8
HOTSPOT_MIN_REQUESTS=3
K_ANON_THRESHOLD=5
RAW_AUDIO_RETENTION_DAYS=30
REQUEST_TEXT_RETENTION_DAYS=730
